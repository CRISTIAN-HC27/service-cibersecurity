# Copia este archivo a .env y completa los valores.
# NUNCA subas .env a git (GV.PO / PR.DS).

# development | production | test
NODE_ENV=development
PORT=3000

# Base de datos
DATABASE_URL=postgresql://app:change_me_password@localhost:5433/login_service

# JWT - secreto de access token (>= 32 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_with_a_random_secret_of_at_least_32_bytes
# Duración del access token (segundos). 15 minutos por defecto.
JWT_ACCESS_TTL_SECONDS=900
# Duración del refresh token (segundos). 7 días por defecto.
JWT_REFRESH_TTL_SECONDS=604800

# Orígenes permitidos por CORS (separados por coma, sin wildcard).
# Incluye el origen desde el que se abre la interfaz web (p. ej.
# https://localhost para /app/), porque OriginGuard valida refresh y logout.
CORS_ORIGINS=http://localhost:5173,https://localhost

# Cookies
COOKIE_SECURE=true

# Correos con acceso al panel de administración (/admin/*), separados por coma.
# El rol no viaja en el token ni se concede al registrarse: se resuelve contra
# esta lista en cada petición. Vacío = panel deshabilitado.
ADMIN_EMAILS=admin@example.com

# Límites de rate limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# Bloqueo de cuenta tras fallos de login
ACCOUNT_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Logging
LOG_LEVEL=info
